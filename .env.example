# Required: Bearer credential used by Custom GPT -> this MCP service.
API_TOKEN=wangran

# Keep the origin private; publish it through Cloudflare Tunnel.
LISTEN_ADDR=127.0.0.1:8788

# Registry containing allowed MCP servers.
MCP_REGISTRY=/etc/mygpt-mcp/servers.json

# Per-request timeout for upstream MCP calls.
REQUEST_TIMEOUT=90s

# Maximum gateway response size in bytes (reserved for response limiting).
MAX_RESPONSE_BYTES=1048576
