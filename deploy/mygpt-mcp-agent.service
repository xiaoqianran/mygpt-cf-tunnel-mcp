[Unit]
Description=MyGPT MCP Action Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/mygpt-mcp/agent.env
ExecStart=/usr/local/bin/mygpt-mcp-agent
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/mygpt-mcp

[Install]
WantedBy=multi-user.target
