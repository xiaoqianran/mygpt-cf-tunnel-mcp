{
  "servers": {
    "context7": {
      "transport": "streamable_http",
      "url": "https://mcp.context7.com/mcp",
      "description": "Up-to-date library and framework documentation",
      "allow_tools": ["resolve-library-id", "query-docs"]
    },
    "deepwiki": {
      "transport": "streamable_http",
      "url": "https://mcp.deepwiki.com/mcp",
      "description": "DeepWiki documentation and Q&A for public GitHub repositories",
      "deny_tools": ["delete_*"]
    },
    "codegraph": {
      "transport": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "working_dir": "/srv/example-repo",
      "description": "Local CodeGraph MCP",
      "allow_tools": ["codegraph_explore"]
    }
  }
}
